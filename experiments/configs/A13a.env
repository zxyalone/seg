# A13a: A11 with a target-CNR attenuation (plan §6c): per sample p = 0.5, each lesion gets alpha = min(1, t / CNR0),
# t drawn from the CNR distribution of the low-CNR tier of the 518 training lesions. No module; training-only change.
PHASER_LCA=1
PHASER_LCA_P=0.5
PHASER_LCA_TARGET=cnr
# Shared V2 settings (every group). Seed is set by queue.sh (PHASER_SEED).
PHASER_NUM_EPOCHS=200
PHASER_FT_WEIGHT=0.0
PHASER_PC_SCALES=3
PHASER_PC_MAX_VOXELS=1048576
PHASER_AUX_WARMUP=5
PHASER_FUSION=none
