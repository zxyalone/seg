# A12: A0 + component-wise DiceCE (CC-DiceCE style, Voronoi partition around GT components; literature baseline, plan §5b)
# No module; the loss is added to the standard deep-supervised DiceCE with weight 1.
PHASER_CC_LOSS=1
PHASER_CC_WEIGHT=1.0
# Shared V2 settings (every group). Seed is set by queue.sh (PHASER_SEED).
PHASER_NUM_EPOCHS=200
PHASER_FT_WEIGHT=0.0
PHASER_PC_SCALES=3
PHASER_PC_MAX_VOXELS=1048576
PHASER_AUX_WARMUP=5
PHASER_FUSION=none
