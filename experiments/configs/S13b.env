# S13b: S0 + DCA + CFC with exactly the A13b settings (p = 0.5, target CNR from the training low-CNR tier,
# consistency weight 1 on the two finest decoder stages). Architecture-transfer test (plan §11, 2026-10-13).
PHASER_ARCH=segresnet
PHASER_LCA=1
PHASER_LCA_P=0.5
PHASER_LCA_TARGET=cnr
PHASER_LCA_CONS_WEIGHT=1.0
PHASER_LCA_CONS_STAGES=2
# Shared V2 settings (every group). Seed is set by queue.sh (PHASER_SEED).
PHASER_NUM_EPOCHS=200
PHASER_FT_WEIGHT=0.0
PHASER_PC_SCALES=3
PHASER_PC_MAX_VOXELS=1048576
PHASER_AUX_WARMUP=5
PHASER_FUSION=none
