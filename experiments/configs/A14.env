# A14: A0 + Pixel2Cancer synthetic tumours (Lai et al., MICCAI 2024; plan §11, 2026-10-14). Offline variants from
# experiments/external/p2c_synthesize.py (K=10 per fold-0 training case); a training case is replaced by one of its
# variants with p=0.9 as in the original TumorSysthesis(prob=0.9). No DCA, no CFC. Descriptive comparator.
PHASER_P2C_DIR=/root/autodl-tmp/nnUNet_data/p2c_synth/Dataset102_fold0
PHASER_P2C_P=0.9
PHASER_PFCR=0
PHASER_PCSF=0
PHASER_SMALL_HEAD=0
# Shared V2 settings (every group). Seed is set by queue.sh (PHASER_SEED).
PHASER_NUM_EPOCHS=200
PHASER_FT_WEIGHT=0.0
PHASER_PC_SCALES=3
PHASER_PC_MAX_VOXELS=1048576
PHASER_AUX_WARMUP=5
PHASER_FUSION=none
