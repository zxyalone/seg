# A1: gradient-magnitude skip gate (amplitude-evidence control), no PFCR, no prior
PHASER_PFCR=0
PHASER_PCSF=1
PHASER_PCSF_MODE=grad
PHASER_PCSF_GATE_SENS=0.5
PHASER_SMALL_HEAD=0
# Shared V2 settings (every group). Seed is set by queue.sh (PHASER_SEED).
PHASER_NUM_EPOCHS=200
PHASER_FT_WEIGHT=0.0
PHASER_PC_SCALES=3
PHASER_PC_MAX_VOXELS=1048576
PHASER_AUX_WARMUP=5
PHASER_FUSION=none
