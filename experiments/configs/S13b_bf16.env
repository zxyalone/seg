# S13b_bf16: S13b (SegResNet + DCA + CFC, exactly the A13b settings) with bf16 autocast instead of fp16.
# The fp16 S13b_s1 run diverged at epoch 114: the unnormalised residual decoder of SegResNet grew under the
# scale-invariant CFC loss until decoder activations exceeded the fp16 maximum (65504). bf16 keeps the fp32
# exponent range; training and inference both use it. Method settings unchanged (plan §11, 2026-10-13).
PHASER_ARCH=segresnet
PHASER_AMP_DTYPE=bf16
PHASER_LCA=1
PHASER_LCA_P=0.5
PHASER_LCA_TARGET=cnr
PHASER_LCA_CONS_WEIGHT=1.0
PHASER_LCA_CONS_STAGES=2
# Shared V2 settings (every group). Seed is set by queue.sh (PHASER_SEED).
PHASER_NUM_EPOCHS=200
PHASER_FT_WEIGHT=0.0
PHASER_PC_SCALES=3
PHASER_PC_MAX_VOXELS=1048576
PHASER_AUX_WARMUP=5
PHASER_FUSION=none
