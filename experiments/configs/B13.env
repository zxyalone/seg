# B13 (docs/训练侧频域计划.md): A13b with B-DCA, i.e. the DCA shift field low-passed at sigma_b = 2 mm
# (target-CNR calibration with the band field). CFC unchanged.
PHASER_LCA_BAND_SIGMA_MM=2.0
# A13b: A13a + contrast-consistency loss (plan §6c): 1 - cosine between decoder features of the attenuated and the
# original patch (teacher = same network, no gradient), inside attenuated lesions dilated by 6 voxels,
# two finest decoder stages, weight 1 with the shared V2 ramp. No module; training-only change.
PHASER_LCA=1
PHASER_LCA_P=0.5
PHASER_LCA_TARGET=cnr
PHASER_LCA_CONS_WEIGHT=1.0
PHASER_LCA_CONS_STAGES=2
# Shared V2 settings (every group). Seed is set by queue.sh (PHASER_SEED).
PHASER_NUM_EPOCHS=200
PHASER_FT_WEIGHT=0.0
PHASER_PC_SCALES=3
PHASER_PC_MAX_VOXELS=1048576
PHASER_AUX_WARMUP=5
PHASER_FUSION=none
