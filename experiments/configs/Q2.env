# Q2 (docs/SALT模型设计.md §4): Q1 + spectral scale-space anchors (SSA): 16 queries anchored on the scale-space maxima
# of the semantic tumour probability, 16 on those of the foreground-restricted CT (Fourier-domain scale-normalised
# LoG bank, radii 2.5-20 mm), 8 free queries.
PHASER_LQD=1
PHASER_LQD_WEIGHT=0.2
PHASER_LQD_LR_MULT=4.0
PHASER_LQD_WARMUP=10
PHASER_LQD_LAYERS=6
PHASER_LQD_HIDDEN=128
PHASER_LQD_HEADS=4
PHASER_LQD_FUSE_W=0.5
PHASER_LQD_SEM=16
PHASER_LQD_IMG=16
PHASER_LQD_FREE=8
PHASER_LQD_SHAPE=0
PHASER_FAF=0
# Shared V2 settings (every group). Seed is set by queue.sh (PHASER_SEED). No DCA / CFC (PHASER_LCA unset).
PHASER_PFCR=0
PHASER_PCSF=0
PHASER_SMALL_HEAD=0
PHASER_NUM_EPOCHS=200
PHASER_FT_WEIGHT=0.0
PHASER_PC_SCALES=3
PHASER_PC_MAX_VOXELS=1048576
PHASER_AUX_WARMUP=5
PHASER_FUSION=none
